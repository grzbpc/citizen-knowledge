<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} &mdash; Citizen Knowledge</title>
<meta name="description" content="{{ description or "A companion record to The Performance of Obedience." }}">
<link rel="stylesheet" href="{{ '/css/style.css' | url }}">
<link rel="icon" href="{{ '/favicon.ico' | url }}">
<link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | url }}">
</head>
<body>
<div class="wrap">
  <a class="backlink" href="{{ '/' | url }}">&larr; Back to the Record</a>
  <header class="post-header brief-header">
    {% if counter %}<span class="counter-badge">Counter-Read &mdash; Boundary Case</span>{% endif %}
    <span class="brief-tag">Brief</span>
    <div class="mapping-bar mapping-bar--brief">
      Part {{ part }}: {{ partTitle }} &rarr; Chapter {{ chapter }}: {{ chapterTitle }}{% if subheading %} &rarr; {{ subheading }}{% endif %}
    </div>
    <h1>{{ title }}</h1>
    <p class="source-line">{{ source }}</p>
  </header>

  {{ content | safe }}

  {# The quote: field is NOT automatically a manuscript excerpt. quote_source
     must be set explicitly to "manuscript" or "article"; anything else (or
     omitted) renders an unlabelled pull-quote. A quote with no verifiable
     source should not be published at all. #}
  {% if quote %}
    {% if quote_source == "manuscript" %}
      <blockquote class="quote--manuscript">{{ quote | safe }}{% if quote_cite %}<span class="cite">{{ quote_cite }}</span>{% endif %}</blockquote>
    {% elif quote_source == "article" %}
      <blockquote class="quote--article">{{ quote | safe }}{% if quote_cite %}<span class="cite">{{ quote_cite }}</span>{% endif %}</blockquote>
    {% else %}
      <blockquote>{{ quote | safe }}</blockquote>
    {% endif %}
  {% endif %}

  {% if book_reference %}
  <div class="mapping-citation mapping-citation--brief{% if counter %} mapping-citation--counter{% endif %}">
    <span class="label">{% if counter %}Book reference &mdash; boundary case{% else %}Book reference{% endif %}</span>
    <p class="book-reference-note">{{ book_reference }}</p>
  </div>
  {% endif %}

  <footer>
    Source: {{ source }}. No images reproduced.
    {% if quote_source == "article" or has_article_quote %}Short quotations from the source article are reproduced verbatim and marked as such; all other summary is original paraphrase.{% else %}All summaries are original paraphrase.{% endif %}
    {% if quote_source == "manuscript" %}Manuscript quotation from <em>The Performance of Obedience</em>, by Greg Lewis, reproduced as a short excerpt for analytical purposes.{% endif %}
  </footer>
</div>
</body>
</html>
