<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} &mdash; Citizen Knowledge</title>
<meta name="description" content="{{ description or "A companion record to The Performance of Obedience." }}">
<link rel="stylesheet" href="{{ '/css/style.css' | url }}">
<link rel="icon" href="{{ '/favicon.ico' | url }}">
<link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | url }}">
</head>
<body>
<div class="wrap">
  <a class="backlink" href="{{ '/' | url }}">&larr; Back to the Record</a>
  <header class="post-header">
    <div class="mapping-bar">
      <span class="label">Maps to The Performance of Obedience</span>
      Part {{ part }}: {{ partTitle }} &rarr; Chapter {{ chapter }}: {{ chapterTitle }}{% if subheading %} &rarr; {{ subheading }}{% endif %}
    </div>
    {% if counter %}<span class="counter-badge">Counter-Read &mdash; Boundary Case</span>{% endif %}
    {% if deep_read %}<span class="deep-read-badge">Deep Read &mdash; With Manuscript</span>{% else %}<span class="standard-tag">Standard</span>{% endif %}
    <h1>{{ title }}</h1>
    <p class="source-line">{{ source }}</p>
  </header>

  {# Standard posts carry no manuscript quotes by default, so no
     .manuscript-quotes wrapper here. If a standard post ever includes
     one, it must be written as raw HTML with class="quote--manuscript"
     and its own .cite line. Article quotes use class="quote--article". #}
  {% if deep_read %}<div class="manuscript-quotes">{% endif %}
  {{ content | safe }}
  {% if deep_read %}</div>{% endif %}

  <div class="mapping-citation{% if counter %} mapping-citation--counter{% endif %}">
    <span class="label">{% if counter %}Book reference &mdash; boundary case{% else %}Book reference{% endif %}</span>
    <strong>Part {{ part }}, {{ partTitle }} &middot; Chapter {{ chapter }}, {{ chapterTitle }}{% if subheading %} &middot; {{ subheading }}{% endif %}</strong>
    {% if book_reference %}<p class="book-reference-note">{{ book_reference }}</p>{% endif %}
  </div>

  <footer>
    Source: {{ source }}. No images reproduced.
    {% if has_article_quote %}Short quotations from the source article are reproduced verbatim and marked as such; all other summary is original paraphrase.{% else %}All summaries are original paraphrase.{% endif %}
    {% if deep_read %}Manuscript quotations from <em>The Performance of Obedience</em> reproduced as brief excerpts for analytical purposes.{% endif %}
  </footer>
</div>
</body>
</html>
