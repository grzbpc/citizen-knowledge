---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>Citizen Knowledge</title>
  <link>https://citizenknowledge.co.uk/</link>
  <description>Citizen Knowledge maps ordinary daily news stories against the argument of The Performance of Obedience: that selective enforcement, not consistent rule-following, is how modern institutions actually operate.</description>
  <language>en-gb</language>
  {%- for post in collections.posts %}
  <item>
    <title>{{ post.data.title }}</title>
    <link>https://citizenknowledge.co.uk{{ post.url | url }}</link>
    <guid>https://citizenknowledge.co.uk{{ post.url | url }}</guid>
    <pubDate>{{ post.data.date.toUTCString() }}</pubDate>
    <description>{{ post.data.description }}</description>
  </item>
  {%- endfor %}
</channel>
</rss>
