<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Search &mdash; Citizen Knowledge</title>
<meta name="description" content="Search every entry in Citizen Knowledge, a companion record to The Performance of Obedience.">
<link rel="stylesheet" href="{{ '/css/style.css' | url }}">
<link rel="icon" href="{{ '/favicon.ico' | url }}">
<link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | url }}">
</head>
<body>
<div class="wrap">
  <a class="backlink" href="{{ '/' | url }}">&larr; Back to the Record</a>
  <header class="masthead">
    <h1 class="title" style="font-size:34px;">Search by keyword</h1>
    <p class="strapline">Search every entry by headline, story, chapter or part.</p>
  </header>
  <main>
    <div class="search-box">
      <input type="text" id="search-input" class="search-input" placeholder="Search entries&hellip;" autocomplete="off">
      <div class="search-filters">
        <label><input type="checkbox" class="search-filter" value="standard" checked> Standard</label>
        <label><input type="checkbox" class="search-filter" value="deep" checked> Deep Read</label>
        <label><input type="checkbox" class="search-filter" value="brief" checked> Brief</label>
        <label><input type="checkbox" id="search-filter-counter" checked> Counter-Read</label>
      </div>
    </div>
    <p id="search-status" class="search-status">Loading index&hellip;</p>
    <div id="search-results"></div>
  </main>
  <footer>
    <p>&copy; Greg Lewis 2026</p>
  </footer>
</div>
<script src="{{ '/js/search.js' | url }}"></script>
</body>
</html>